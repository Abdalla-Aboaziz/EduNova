{
  "ConnectionStrings": {
    "EduNova": "Server=.;Database=EduNova;Trusted_Connection=true;TrustServerCertificate=true;MultipleActiveResultSets=true",
    "Redis": "localhost:6379"
  },
  "EduNova": {
    "DemoStudentId": "demo-student-1",
    "DemoStudentName": "Mona Ahmed",
    "CurrentYearNumber": 4,
    "CurrentSemesterOrder": 1
  },
  "Firebase": {
    "CredentialsPath": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "AllowedHosts": "*"
}