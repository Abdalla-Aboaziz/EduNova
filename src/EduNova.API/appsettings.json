{
  "ConnectionStrings": {
    "EduNova": "Server=(localdb)\\MSSQLLocalDB;Database=EduNova;Trusted_Connection=true;TrustServerCertificate=true;MultipleActiveResultSets=true"
  },

  "EduNova": {
    "DemoStudentId": "demo-student-1",
    "DemoStudentName": "Mona Ahmed",
    "CurrentYearNumber": 4,
    "CurrentSemesterOrder": 1
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },

  "Jwt": {
    "Key": "EduNova-Dev-Jwt-Key-2026-Use-A-Long-Random-Secret-Here!",
    "Issuer": "EduNova",
    "Audience": "EduNova.Client",
    "DurationInMinutes": 30
  },

  "AllowedHosts": "*"
}